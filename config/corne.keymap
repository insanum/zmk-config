#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "default";
                        bindings = <
   &none    &kp Q          &kp W         &kp E         &kp R          &kp T      &kp Y    &kp U          &kp I         &kp O         &kp P             &none
   &none    &mt LCTRL A    &mt LALT S    &mt LGUI D    &mt LSHFT F    &kp G      &kp H    &mt RSHFT J    &mt LGUI K    &mt RALT L    &mt RCTRL SEMI    &none
   &none    &kp Z          &kp X         &kp C         &kp V          &kp B      &kp N    &kp M          &kp COMMA     &kp DOT       &kp FSLH          &none

   &kp LSHFT    &lt 1 BSPC    &mt LGUI ESC      &mt RGUI RET   &lt 2 SPACE   &kp RSHFT
                        >;
                };

                symbols_layer {
                        display-name = "symbols";
                        bindings = <
   &none    &kp TAB      &none        &kp LBRC    &kp RBRC    &kp ASTRK      &kp N1      &kp N2      &kp N3    &kp PLUS        &kp MULTIPLY    &none
   &none    &none        &none        &kp LPAR    &kp RPAR    &kp UNDER      &kp N4      &kp N5      &kp N6    &kp SUBTRACT    &kp DIVIDE      &none
   &none    &kp TILDE    &kp GRAVE    &kp LBKT    &kp RBKT    &kp MINUS      &kp N7      &kp N8      &kp N9    &kp DOT         &kp EQUAL       &none

   &kp LSHFT    &trans    &none      &none    &none    &kp N0
                        >;
                };

                functions_layer {
                        display-name = "functions";
                        bindings = <
   &none    &kp F1        &kp F2          &kp F3          &kp F4        &kp F5      &kp F6      &kp F7      &kp F8    &kp F9       &kp F10    &none
   &none    &none         &kp K_VOL_DN    &kp K_VOL_UP    &kp K_MUTE    &none       &kp LEFT    &kp DOWN    &kp UP    &kp RIGHT    &kp F11    &none
   &none    &bt BT_PRV    &bt BT_NXT      &bt BT_CLR      &trans        &none       &none       &none       &none     &none        &kp F12    &none

   &none    &none    &none      &none    &trans   &none
                        >;
                };
        };
};
